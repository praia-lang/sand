// Reject URLs that could be parsed as a git option, contain whitespace,
// or are otherwise unsafe to pass to `git clone`. Accepts the common URL
// forms (https://, http://, file://, git@host:path) and bare host/path
// (parseSpec prepends https://). Printable-ASCII only.
func isValidUrl(url) {
  if (!url || type(url) != "string") { return false }
  if (len(url) == 0) { return false }
  if (url.startsWith("-")) { return false }
  return url.test("^[!-~]+$")
}

// Refs/tags/branches. Conservative: alnum, dot, underscore, slash, plus,
// dash (not leading). Covers every real-world tag we'd encounter and
// rules out anything that could be parsed as a git option by `checkout`.
func isValidRef(ref) {
  if (!ref || type(ref) != "string") { return false }
  if (len(ref) == 0 || len(ref) > 200) { return false }
  if (ref.startsWith("-")) { return false }
  return ref.test("^[a-zA-Z0-9._+/-]+$")
}

// Detect the SCP-like SSH form `user@host:path`. The @ in that
// shape belongs to the URL (separating user from host), not to a
// `<spec>@<version>` pin. We use this in two places:
//   • the version-splitter, to avoid treating SSH's @ as a pin;
//   • the scheme-prepender, to avoid wrapping SSH URLs in https://.
// `ssh://` URLs use the standard `://path` layout and are handled
// alongside the other explicit schemes — they don't need this
// detection.
func _isSshSpec(s) {
  if (s.startsWith("http://") || s.startsWith("https://") ||
      s.startsWith("file://") || s.startsWith("ssh://")) {
    return false
  }
  let at = s.indexOf("@")
  let col = s.indexOf(":")
  if (at <= 0 || col <= at) { return false }
  // host must look like a hostname (no slashes, no colons, no @).
  // This is intentionally narrow — anything looser would risk
  // matching `user:pass@host` HTTP basic-auth forms.
  let host = s.slice(at + 1, col)
  if (len(host) == 0) { return false }
  return host.test("^[a-zA-Z0-9._-]+$")
}

func parseSpec(spec) {
  let version = nil
  let urlPart = spec

  // Pin syntax is `<spec>@<version>`. We split on the last `@` only
  // when what follows it parses as a tag-like version: alphanumeric
  // plus `._+-`. The pattern rejects:
  //   • `:` — URL schemes (https://, ssh://) and SSH's host:path
  //   • `/` — URL path components, SSH user@host/path
  // both of which would otherwise be misread as a "version".
  //
  // Side-effect: a branch name containing `/` (e.g. `release/v1`)
  // can't be used as a version pin via the `@` shorthand — the
  // installer would have to receive that ref through some other
  // channel. In practice, version pins are tags/SHAs; multi-segment
  // branches are an anti-reproducibility pattern the lockfile's SHA
  // pin is meant to discourage.
  let atIdx = urlPart.lastIndexOf("@")
  if (atIdx > 0) {
    let candidate = urlPart.slice(atIdx + 1, len(urlPart))
    if (candidate.test("^[a-zA-Z0-9][a-zA-Z0-9._+-]*$")) {
      version = candidate
      urlPart = urlPart.slice(0, atIdx)
    }
  }

  // Extract name from last path segment. For SSH `user@host:path`,
  // split("/") keeps the host:user prefix on the first segment but
  // the last segment is still the repo name we want.
  let segments = urlPart.split("/")
  let name = segments[len(segments) - 1]

  // Remove .git suffix if present
  if (name.endsWith(".git")) {
    name = name.slice(0, len(name) - 4)
  }

  // Build full clone URL.
  //
  // Don't prepend https:// to forms that are already a valid clone
  // URL on their own — explicit schemes (https/http/file/ssh) and
  // SCP-style SSH (user@host:path). Everything else is treated as
  // shorthand for `https://<thing>`.
  let fullUrl = urlPart
  let alreadyScheme = urlPart.startsWith("https://") ||
                       urlPart.startsWith("http://") ||
                       urlPart.startsWith("file://") ||
                       urlPart.startsWith("ssh://")
  let isSsh = _isSshSpec(urlPart)
  if (!alreadyScheme && !isSsh) {
    fullUrl = "https://%{urlPart}"
  }
  // Append .git for HTTP(S) clone URLs. SSH clone URLs work with or
  // without .git (github accepts both); appending matches convention
  // and lets the canonical sand-source comparison (in cli.praia)
  // line up across spec shapes that all normalize to the same URL.
  // file:// URLs deliberately don't get .git — they point at
  // file-system paths, not bare git repos.
  if (!fullUrl.endsWith(".git") && !fullUrl.startsWith("file://")) {
    fullUrl = "%{fullUrl}.git"
  }

  // Validate at the gate so every code path that builds a git URL
  // gets checked once, regardless of how the URL was massaged.
  if (!isValidUrl(fullUrl)) {
    throw "Invalid grain URL: %{spec}"
  }
  if (version != nil && !isValidRef(version)) {
    throw "Invalid grain version: %{version}"
  }

  return { url: fullUrl, version: version, name: name }
}

func clone(url, dest, verbose = false) {
  // Re-validate even though parseSpec already does — defense in depth
  // for callers that bypass parseSpec.
  if (!isValidUrl(url)) { throw "Invalid clone URL" }
  let cmd = ["git", "clone"]
  if (!verbose) { push(cmd, "--quiet") }
  // -- ensures git treats the URL as positional, not an option, even
  // if a future caller slips a string starting with `-` past validation.
  push(cmd, "--")
  push(cmd, url)
  push(cmd, dest)
  let r = sys.exec(cmd)
  if (verbose && len(r.stderr.strip()) > 0) { print(r.stderr.strip()) }
  if (r.exitCode != 0) {
    let msg = r.stderr.strip()
    if (len(msg) == 0) { msg = r.stdout.strip() }
    throw "git clone failed: %{msg}"
  }
}

func checkout(dir, tag, verbose = false) {
  // `git checkout -- <ref>` means "restore <ref> from index", not "check out
  // ref <ref>". So we can't use `--` here — validation is the only line
  // of defense. Skip any attempt that doesn't pass isValidRef.
  let attempts = [tag, "v%{tag}"]
  for (attempt in attempts) {
    if (!isValidRef(attempt)) { continue }
    let cmd = ["git", "-C", dir, "checkout"]
    if (!verbose) { push(cmd, "--quiet") }
    push(cmd, attempt)
    let r = sys.exec(cmd)
    if (verbose && len(r.stderr.strip()) > 0) { print(r.stderr.strip()) }
    if (r.exitCode == 0) { return }
  }
  throw "Version '%{tag}' not found (tried tag '%{tag}', 'v%{tag}')"
}

// Resolve a remote ref to its SHA *without* cloning. Used by
// `sand update` to short-circuit when the recorded commit already
// matches what the remote serves — saves a full clone+swap when
// nothing has actually changed.
//
// `version` semantics mirror parseSpec:
//   • nil or "latest" → probe HEAD.
//   • a tag-like token → probe `refs/tags/<v>` first, then
//     `refs/tags/v<v>` (to match the bare-vs-v-prefix dance that
//     checkout() already does), then `refs/heads/<v>`.
//
// Returns the resolved 40-char SHA on first match, or nil when no
// candidate ref exists on the remote. Throws only on transport
// failure (no network, repo gone) — caller decides whether to
// degrade gracefully or surface the error.
func lsRemote(url, version) {
  if (!isValidUrl(url)) { throw "Invalid remote URL for ls-remote" }
  let refs = []
  if (!version || version == "latest") {
    push(refs, "HEAD")
  } else {
    push(refs, "refs/tags/" + version)
    push(refs, "refs/tags/v" + version)
    push(refs, "refs/heads/" + version)
  }
  let lastErr = nil
  for (ref in refs) {
    if (!isValidRef(ref)) { continue }
    let r = sys.exec(["git", "ls-remote", "--quiet", "--exit-code", "--", url, ref])
    if (r.exitCode == 0) {
      // Output is "<sha>\t<ref>\n..." — take the first line's SHA.
      let line = r.stdout.split("\n")[0]
      let parts = line.split("\t")
      if (len(parts) >= 1 && len(parts[0]) == 40 && parts[0].test("^[a-f0-9]+$")) {
        return parts[0]
      }
    } elif (r.exitCode != 2) {
      // exit 2 = ref not found (try the next candidate). Anything
      // else is a real transport error worth surfacing.
      lastErr = r.stderr.strip()
      if (len(lastErr) == 0) { lastErr = r.stdout.strip() }
    }
  }
  if (lastErr) { throw "git ls-remote failed: %{lastErr}" }
  return nil
}

// Resolve a ref (or HEAD) to its full commit SHA. Used by the installer
// to pin the lockfile to a concrete commit even when the user requested
// a moving target like a branch tip or "latest".
func revParse(dir, ref = "HEAD") {
  if (!isValidRef(ref)) { throw "Invalid ref for rev-parse: %{ref}" }
  let r = sys.exec(["git", "-C", dir, "rev-parse", ref])
  if (r.exitCode != 0) {
    let msg = r.stderr.strip()
    if (len(msg) == 0) { msg = r.stdout.strip() }
    throw "git rev-parse failed: %{msg}"
  }
  let sha = r.stdout.strip()
  // A full SHA-1 commit is 40 lowercase hex chars. Defend against
  // anything weirder so the value going into the lockfile is always
  // round-trippable as a ref.
  if (len(sha) != 40 || !sha.test("^[a-f0-9]+$")) {
    throw "git rev-parse returned an unexpected value: %{sha}"
  }
  return sha
}

export { parseSpec, clone, checkout, revParse, lsRemote, isValidUrl, isValidRef }
