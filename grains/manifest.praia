use "./config"

func has(m, key) {
  let ks = keys(m)
  for (k in ks) {
    if (k == key) { return true }
  }
  return false
}

// Match GitHub-ish naming: alphanumerics, _, -. Must start alphanumeric.
// Length-bounded to avoid pathological filenames.
func isValidName(name) {
  if (!name || type(name) != "string") { return false }
  if (len(name) == 0 || len(name) > 64) { return false }
  return name.test("^[a-zA-Z0-9][a-zA-Z0-9_-]*$")
}

// Reject absolute paths, parent traversal, anything that isn't a .praia file.
// Used for the `main` field in grain.yaml — must be a path relative to the
// grain directory.
func isValidMainPath(p) {
  if (!p || type(p) != "string") { return false }
  if (len(p) == 0) { return false }
  if (p.startsWith("/") || p.startsWith("\\")) { return false }
  if (p.contains("..")) { return false }
  if (!p.endsWith(".praia")) { return false }
  return true
}

// `bin:` entry names become files in $BINDIR — must follow the same
// charset as grain names (no slashes, no leading dot, no surprises that
// could let a manifest write outside the intended directory).
func isValidBinName(name) {
  return isValidName(name)
}

// `bin:` entry values are relative paths within the grain that resolve
// to a .praia script. Same restrictions as `main:`.
func isValidBinPath(p) {
  return isValidMainPath(p)
}

// `prebuilt:` keys identify a target platform. Format:
// `<platform>-<arch>`, e.g. `darwin-arm64`, `linux-x86_64`,
// `linux-aarch64`. Also accept the special `darwin-universal`
// case (lipo'd Mach-O). The regex is intentionally narrow —
// we never want a hand-edited grain.yaml to smuggle path
// separators or shell metachars through this key.
func isValidPlatformKey(k) {
  if (!k || type(k) != "string") { return false }
  return k.test("^[a-z]+-[a-z0-9_]+$")
}

// `prebuilt:` URLs MUST be https. Without that constraint a
// malicious or misconfigured grain could fetch over plain http
// where a network attacker can swap the binary before the hash
// check fires (defense-in-depth — we still verify sha256, but
// https adds transport integrity). file:// is forbidden too:
// a `prebuilt:` entry should be reproducible from anywhere.
func isValidPrebuiltUrl(u) {
  if (!u || type(u) != "string") { return false }
  return u.startsWith("https://")
}

// Subresource-integrity-style: `sha256-<64 lowercase hex chars>`.
// Matches the format integrity.compute() already produces for the
// installed-tree hash, so the lockfile and the prebuilt block
// share one canonical shape.
func isValidIntegrity(s) {
  if (!s || type(s) != "string") { return false }
  return s.test("^sha256-[0-9a-f]{64}$")
}

func read(dir) {
  let filepath = path.join(dir, config.MANIFEST_NAME)
  ensure (fs.exists(filepath)) else {
    throw "No grain.yaml found in %{dir}"
  }
  let content = fs.read(filepath)
  // Truly empty manifests round-trip as nil — that's a degenerate
  // grain.yaml but not a parse failure. A non-empty document that
  // parses to nil, on the other hand, is malformed: callers that
  // looked at `grainManifest.main` or `grainManifest.bin` would
  // silently treat the grain as if those fields were absent. Loud
  // error here matches the policy in registry.load.
  if (len(content.strip()) == 0) { return nil }
  let m = yaml.parse(content)
  if (!m) {
    throw "Manifest %{filepath} is not valid YAML"
  }
  // Validate untrusted manifest fields at the source so all callers are safe.
  if (has(m, "name") && m.name) {
    ensure (isValidName(m.name)) else {
      throw "Invalid grain name in %{filepath}: '%{m.name}' (must match [a-zA-Z0-9][a-zA-Z0-9_-]*)"
    }
  }
  if (has(m, "main") && m.main) {
    ensure (isValidMainPath(m.main)) else {
      throw "Invalid main path in %{filepath}: '%{m.main}' (must be a relative .praia file, no '..')"
    }
  }
  // `bin:` declares CLI wrappers planted on PATH at install time. Each
  // key becomes a filename in the bindir, each value points at a script
  // inside the grain — both need the same path-safety guard as `main`.
  // Reserved names (sand/praia) are enforced one layer up at install
  // time, not here, since sand's own grain.yaml legitimately declares
  // `bin: { sand: main.praia }`.
  if (has(m, "bin") && m.bin) {
    let binKeys = keys(m.bin)
    for (k in binKeys) {
      ensure (isValidBinName(k)) else {
        throw "Invalid bin name '%{k}' in %{filepath} (must match [a-zA-Z0-9][a-zA-Z0-9_-]*)"
      }
      ensure (isValidBinPath(m.bin[k])) else {
        throw "Invalid bin path for '%{k}' in %{filepath}: '%{m.bin[k]}' (must be a relative .praia file, no '..')"
      }
    }
  }
  // `prebuilt:` declares per-platform binaries to download instead
  // of building from source. Each value is itself a map with `url`
  // (https) and `integrity` (sha256-<hex>). Reject the whole
  // manifest if any entry is malformed — a typo in the URL or hash
  // is the kind of bug that's better caught at install time than
  // after the user has chmod'd a wrong binary into place.
  if (has(m, "prebuilt") && m.prebuilt) {
    ensure (type(m.prebuilt) == "map") else {
      throw "Invalid prebuilt in %{filepath}: expected a mapping"
    }
    let pbKeys = keys(m.prebuilt)
    for (k in pbKeys) {
      ensure (isValidPlatformKey(k)) else {
        throw "Invalid prebuilt platform key '%{k}' in %{filepath} (must match <platform>-<arch>, e.g. darwin-arm64, linux-x86_64)"
      }
      let entry = m.prebuilt[k]
      ensure (type(entry) == "map") else {
        throw "Invalid prebuilt entry '%{k}' in %{filepath}: expected a mapping with `url` and `integrity`"
      }
      ensure (isValidPrebuiltUrl(entry.url)) else {
        throw "Invalid prebuilt URL for '%{k}' in %{filepath} (must be https://): '%{entry.url}'"
      }
      ensure (isValidIntegrity(entry.integrity)) else {
        throw "Invalid prebuilt integrity for '%{k}' in %{filepath} (must be sha256-<64 hex chars>): '%{entry.integrity}'"
      }
    }
  }
  return m
}

func write(dir, m) {
  // Field order is fixed (not whatever the underlying hash map
  // iterates as) so a write/read/write cycle produces stable output
  // and the init-time hint splice that anchors on "dependencies:"
  // keeps working. Each value goes through yaml.stringify so a
  // description like `A test: with a colon and #hash` can't break
  // out of its scalar context and corrupt the file.
  let filepath = path.join(dir, config.MANIFEST_NAME)
  let lines = ""
  lines = lines + "name: %{yaml.stringify(m.name)}\n"
  lines = lines + "version: %{yaml.stringify(m.version)}\n"
  if (has(m, "description")) {
    lines = lines + "description: %{yaml.stringify(m.description)}\n"
  }
  // `author` is unconditionally emitted to keep the manifest shape
  // stable across grain.yamls written by sand. Two display rules:
  //   • nil OR empty string  → bare `author: ` (the user-requested
  //     placeholder — `author: ""` looks like noise the user has
  //     to clean up by hand);
  //   • anything else        → `author: %{yaml.stringify(a)}` —
  //     so a non-string author value (e.g. someone hand-edited
  //     `author: 42` into grain.yaml) survives a read/write round
  //     trip rather than being silently erased.
  let a = m.author
  let isEmpty = (a == nil) || (type(a) == "string" && len(a) == 0)
  if (isEmpty) {
    lines = lines + "author: \n"
  } else {
    lines = lines + "author: %{yaml.stringify(a)}\n"
  }
  if (has(m, "license") && m.license) {
    lines = lines + "license: %{yaml.stringify(m.license)}\n"
  }
  if (has(m, "main") && m.main) {
    lines = lines + "main: %{yaml.stringify(m.main)}\n"
  }
  if (has(m, "bin") && m.bin) {
    let binKeys = keys(m.bin)
    if (len(binKeys) > 0) {
      lines = lines + "bin:\n"
      for (k in binKeys) {
        lines = lines + "  %{yaml.stringify(k)}: %{yaml.stringify(m.bin[k])}\n"
      }
    }
  }
  // `prebuilt:` round-trip. Each entry is itself a mapping; emit
  // url + integrity in a fixed order so a write/read/write cycle
  // is byte-stable. Only emit when the block has at least one
  // entry — an empty prebuilt: with no children parses back as
  // nil, which we'd just have to special-case on the read side.
  if (has(m, "prebuilt") && m.prebuilt) {
    let pbKeys = keys(m.prebuilt)
    if (len(pbKeys) > 0) {
      lines = lines + "prebuilt:\n"
      for (k in pbKeys) {
        let e = m.prebuilt[k]
        lines = lines + "  %{yaml.stringify(k)}:\n"
        lines = lines + "    url: %{yaml.stringify(e.url)}\n"
        lines = lines + "    integrity: %{yaml.stringify(e.integrity)}\n"
      }
    }
  }
  lines = lines + "dependencies:\n"
  if (has(m, "dependencies") && m.dependencies) {
    let depKeys = keys(m.dependencies)
    if (len(depKeys) > 0) {
      for (k in depKeys) {
        lines = lines + "  %{yaml.stringify(k)}: %{yaml.stringify(m.dependencies[k])}\n"
      }
    }
  }
  fs.write(filepath, lines)
}

func create(name, author = nil) {
  // `author` is always present as a key — write() emits it as either
  // `author: <value>` or bare `author: ` (no `""`) so the field acts
  // as a placeholder the user can fill in.
  return {
    name: name,
    version: "0.1.0",
    description: "A tiny sand grain on a large beach",
    author: author,
    license: "MIT",
    main: config.DEFAULT_MAIN,
    dependencies: {}
  }
}

func addDep(dir, name, source) {
  let m = read(dir)
  if (!has(m, "dependencies") || !m.dependencies) {
    m.dependencies = {}
  }
  m.dependencies[name] = source
  write(dir, m)
}

func removeDep(dir, name) {
  let m = read(dir)
  if (has(m, "dependencies") && m.dependencies) {
    let newDeps = {}
    let depKeys = keys(m.dependencies)
    for (k in depKeys) {
      if (k != name) {
        newDeps[k] = m.dependencies[k]
      }
    }
    m.dependencies = newDeps
    write(dir, m)
  }
}

export {
  read, write, create, addDep, removeDep,
  isValidName, isValidMainPath, isValidBinName, isValidBinPath,
  isValidPlatformKey, isValidPrebuiltUrl, isValidIntegrity
}
