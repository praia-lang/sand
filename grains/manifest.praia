use "./config"

func has(m, key) {
  let ks = keys(m)
  for (k in ks) {
    if (k == key) { return true }
  }
  return false
}

// Match GitHub-ish naming: alphanumerics, _, -. Must start alphanumeric.
// Length-bounded to avoid pathological filenames.
func isValidName(name) {
  if (!name || type(name) != "string") { return false }
  if (len(name) == 0 || len(name) > 64) { return false }
  return name.test("^[a-zA-Z0-9][a-zA-Z0-9_-]*$")
}

// Reject absolute paths, parent traversal, anything that isn't a .praia file.
// Used for the `main` field in grain.yaml — must be a path relative to the
// grain directory.
func isValidMainPath(p) {
  if (!p || type(p) != "string") { return false }
  if (len(p) == 0) { return false }
  if (p.startsWith("/") || p.startsWith("\\")) { return false }
  if (p.contains("..")) { return false }
  if (!p.endsWith(".praia")) { return false }
  return true
}

// `bin:` entry names become files in $BINDIR — must follow the same
// charset as grain names (no slashes, no leading dot, no surprises that
// could let a manifest write outside the intended directory).
func isValidBinName(name) {
  return isValidName(name)
}

// `bin:` entry values are relative paths within the grain that resolve
// to a .praia script. Same restrictions as `main:`.
func isValidBinPath(p) {
  return isValidMainPath(p)
}

func read(dir) {
  let filepath = path.join(dir, config.MANIFEST_NAME)
  ensure (fs.exists(filepath)) else {
    throw "No grain.yaml found in %{dir}"
  }
  let content = fs.read(filepath)
  // Truly empty manifests round-trip as nil — that's a degenerate
  // grain.yaml but not a parse failure. A non-empty document that
  // parses to nil, on the other hand, is malformed: callers that
  // looked at `grainManifest.main` or `grainManifest.bin` would
  // silently treat the grain as if those fields were absent. Loud
  // error here matches the policy in registry.load.
  if (len(content.strip()) == 0) { return nil }
  let m = yaml.parse(content)
  if (!m) {
    throw "Manifest %{filepath} is not valid YAML"
  }
  // Validate untrusted manifest fields at the source so all callers are safe.
  if (has(m, "name") && m.name) {
    ensure (isValidName(m.name)) else {
      throw "Invalid grain name in %{filepath}: '%{m.name}' (must match [a-zA-Z0-9][a-zA-Z0-9_-]*)"
    }
  }
  if (has(m, "main") && m.main) {
    ensure (isValidMainPath(m.main)) else {
      throw "Invalid main path in %{filepath}: '%{m.main}' (must be a relative .praia file, no '..')"
    }
  }
  // `bin:` declares CLI wrappers planted on PATH at install time. Each
  // key becomes a filename in the bindir, each value points at a script
  // inside the grain — both need the same path-safety guard as `main`.
  // Reserved names (sand/praia) are enforced one layer up at install
  // time, not here, since sand's own grain.yaml legitimately declares
  // `bin: { sand: main.praia }`.
  if (has(m, "bin") && m.bin) {
    let binKeys = keys(m.bin)
    for (k in binKeys) {
      ensure (isValidBinName(k)) else {
        throw "Invalid bin name '%{k}' in %{filepath} (must match [a-zA-Z0-9][a-zA-Z0-9_-]*)"
      }
      ensure (isValidBinPath(m.bin[k])) else {
        throw "Invalid bin path for '%{k}' in %{filepath}: '%{m.bin[k]}' (must be a relative .praia file, no '..')"
      }
    }
  }
  return m
}

func write(dir, m) {
  // Field order is fixed (not whatever the underlying hash map
  // iterates as) so a write/read/write cycle produces stable output
  // and the init-time hint splice that anchors on "dependencies:"
  // keeps working. Each value goes through yaml.stringify so a
  // description like `A test: with a colon and #hash` can't break
  // out of its scalar context and corrupt the file.
  let filepath = path.join(dir, config.MANIFEST_NAME)
  let lines = ""
  lines = lines + "name: %{yaml.stringify(m.name)}\n"
  lines = lines + "version: %{yaml.stringify(m.version)}\n"
  if (has(m, "description")) {
    lines = lines + "description: %{yaml.stringify(m.description)}\n"
  }
  if (has(m, "author")) {
    lines = lines + "author: %{yaml.stringify(m.author)}\n"
  }
  if (has(m, "license") && m.license) {
    lines = lines + "license: %{yaml.stringify(m.license)}\n"
  }
  if (has(m, "main") && m.main) {
    lines = lines + "main: %{yaml.stringify(m.main)}\n"
  }
  if (has(m, "bin") && m.bin) {
    let binKeys = keys(m.bin)
    if (len(binKeys) > 0) {
      lines = lines + "bin:\n"
      for (k in binKeys) {
        lines = lines + "  %{yaml.stringify(k)}: %{yaml.stringify(m.bin[k])}\n"
      }
    }
  }
  lines = lines + "dependencies:\n"
  if (has(m, "dependencies") && m.dependencies) {
    let depKeys = keys(m.dependencies)
    if (len(depKeys) > 0) {
      for (k in depKeys) {
        lines = lines + "  %{yaml.stringify(k)}: %{yaml.stringify(m.dependencies[k])}\n"
      }
    }
  }
  fs.write(filepath, lines)
}

func create(name) {
  return {
    name: name,
    version: "0.1.0",
    description: "A tiny sand grain on a large beach",
    author: "Unknown",
    license: "MIT",
    main: config.DEFAULT_MAIN,
    dependencies: {}
  }
}

func addDep(dir, name, source) {
  let m = read(dir)
  if (!has(m, "dependencies") || !m.dependencies) {
    m.dependencies = {}
  }
  m.dependencies[name] = source
  write(dir, m)
}

func removeDep(dir, name) {
  let m = read(dir)
  if (has(m, "dependencies") && m.dependencies) {
    let newDeps = {}
    let depKeys = keys(m.dependencies)
    for (k in depKeys) {
      if (k != name) {
        newDeps[k] = m.dependencies[k]
      }
    }
    m.dependencies = newDeps
    write(dir, m)
  }
}

export { read, write, create, addDep, removeDep, isValidName, isValidMainPath, isValidBinName, isValidBinPath }
