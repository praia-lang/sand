let MANIFEST_NAME = "grain.yaml"

// Read version from grain.yaml so it's defined in one place
let _sandDir = path.dirname(path.dirname(sys.currentFile()))
let _manifest = yaml.parse(fs.read(path.join(_sandDir, MANIFEST_NAME)))
let SAND_VERSION = _manifest.version
let LOCK_NAME = "sand-lock.yaml"
let DEFAULT_MAIN = "main.praia"
let EXT_GRAINS_DIR = "ext_grains"

func home() {
  return sys.env("HOME")
}

// User-global: ~/.praia/ext_grains/ (no root needed)
func userGlobalDir() {
  return path.join(home(), ".praia", "ext_grains")
}

// System-global: <libdir>/ext_grains/ (requires root)
// Uses sys.libdir (baked into praia at install time),
// otherwise falls back to /usr/local/lib/praia
func systemGlobalDir() {
  let libdir = sys.libdir
  if (!libdir) { libdir = "/usr/local/lib/praia" }
  return path.join(libdir, "ext_grains")
}

// Choose global dir based on whether we're running as root
func globalGrainsDir() {
  if (sys.isRoot()) {
    return systemGlobalDir()
  }
  return userGlobalDir()
}

func globalLockFile() {
  return path.join(globalGrainsDir(), ".sand-lock.yaml")
}

func localGrainsDir() {
  return path.join(sys.cwd(), EXT_GRAINS_DIR)
}

func localLockFile() {
  return path.join(sys.cwd(), LOCK_NAME)
}

// User-global bindir: ~/.praia/bin/. Mirrors userGlobalDir() — same
// directory tree, so wrappers for user-scope grains land next to the
// grains they wrap.
func userBinDir() {
  return path.join(home(), ".praia", "bin")
}

// System-global bindir: derived from sys.libdir.
// libdir is `<prefix>/lib/praia`, so the matching bindir is
// `<prefix>/bin` — two `path.dirname` calls peel off the suffix.
// Fallback /usr/local/bin keeps `make install` working when praia
// was built without -DPRAIA_LIBDIR.
func systemBinDir() {
  let libdir = sys.libdir
  if (!libdir) { return "/usr/local/bin" }
  return path.join(path.dirname(path.dirname(libdir)), "bin")
}

// Choose bindir based on whether we're running as root, matching the
// scope decision globalGrainsDir() makes for the grain payload.
func globalBinDir() {
  if (sys.isRoot()) {
    return systemBinDir()
  }
  return userBinDir()
}

func ensureDir(dir) {
  if (!fs.exists(dir)) {
    fs.mkdir(dir)
  }
}

export {
  SAND_VERSION, MANIFEST_NAME, LOCK_NAME, DEFAULT_MAIN, EXT_GRAINS_DIR,
  home, globalGrainsDir, globalLockFile, localGrainsDir, localLockFile, ensureDir,
  userBinDir, systemBinDir, globalBinDir
}
