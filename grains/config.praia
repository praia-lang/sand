let MANIFEST_NAME = "grain.yaml"

// Read version from grain.yaml so it's defined in one place
let _sandDir = path.dirname(path.dirname(sys.currentFile()))
let _manifest = yaml.parse(fs.read(path.join(_sandDir, MANIFEST_NAME)))
let SAND_VERSION = _manifest.version
let LOCK_NAME = "sand-lock.yaml"
let DEFAULT_MAIN = "main.praia"
let EXT_GRAINS_DIR = "ext_grains"
// Upstream source of truth for sand itself. Used by synthSandEntry
// (when bootstrapping the lockfile for `sand list -g`) and by the
// update-check probe.
let SAND_REPO = "github.com/praia-lang/sand"
let SAND_REPO_URL = "https://github.com/praia-lang/sand.git"

// Reserved-name gate: is `url` an acceptable source for the grain
// claiming the name "sand"? Only the canonical upstream or a local
// file:// path. Anything else is a fork trying to take over the
// reserved `sand` bin wrapper. Lives here next to the canonical URL
// constants so the policy is testable in isolation — see
// test_sand_reserved_name.praia.
func isAllowedSandSource(url) {
  if (!url || type(url) != "string") { return false }
  if (url == SAND_REPO_URL) { return true }
  if (url.startsWith("file://")) { return true }
  return false
}

func home() {
  return sys.env("HOME")
}

// User-global: ~/.praia/ext_grains/ (no root needed)
func userGlobalDir() {
  return path.join(home(), ".praia", "ext_grains")
}

// System-global: <libdir>/ext_grains/ (requires root)
// Uses sys.libdir (baked into praia at install time),
// otherwise falls back to /usr/local/lib/praia
func systemGlobalDir() {
  let libdir = sys.libdir
  if (!libdir) { libdir = "/usr/local/lib/praia" }
  return path.join(libdir, "ext_grains")
}

// Choose global dir based on whether we're running as root
func globalGrainsDir() {
  if (sys.isRoot()) {
    return systemGlobalDir()
  }
  return userGlobalDir()
}

func globalLockFile() {
  return path.join(globalGrainsDir(), ".sand-lock.yaml")
}

func localGrainsDir() {
  return path.join(sys.cwd(), EXT_GRAINS_DIR)
}

func localLockFile() {
  return path.join(sys.cwd(), LOCK_NAME)
}

// User-level sand settings live alongside the global grains tree so a
// fresh `make install` doesn't have to plant anything in $HOME — the
// file is created lazily on first `sand config <key> <value>`.
let CONFIG_NAME = "sand-config.yaml"
func userConfigFile() {
  return path.join(home(), ".praia", CONFIG_NAME)
}

// Schema of recognized config keys → declared value type. Adding a
// new setting means adding an entry here so `sand config <key>
// <value>` validates input at the boundary and coerces booleans to
// their real type before writing (otherwise `updateCheck: "false"`
// — a string — round-trips as truthy when read back).
let CONFIG_SCHEMA = {
  author: "string",
  license: "string",
  updateCheck: "bool"
}
// Iteration order from `keys()` follows insertion order, so this list
// is deterministic for help output.
let CONFIG_KEYS = keys(CONFIG_SCHEMA)
func isValidConfigKey(k) {
  return CONFIG_SCHEMA.has(k)
}
func configKeyType(k) {
  return CONFIG_SCHEMA[k]
}

func readUserConfig() {
  let p = userConfigFile()
  if (!fs.exists(p)) { return {} }
  // Both fs.read and yaml.parse are wrapped: fs.read can throw on
  // a TOCTOU delete after fs.exists or on a permission flap, and
  // yaml.parse — though permissive today — shouldn't be allowed to
  // take down the caller on a future tightening or a pathological
  // hand-edit. The function's contract is "always returns a map";
  // cmdConfig calls it without its own try/catch precisely because
  // of this guarantee.
  let content = ""
  try { content = fs.read(p) } catch (e) { return {} }
  if (len(content.strip()) == 0) { return {} }
  let data = nil
  try { data = yaml.parse(content) } catch (e) { return {} }
  if (!data || type(data) != "map") { return {} }
  return data
}

// Returns true unless the user has explicitly disabled the update
// check. Defaults to true (the historical behaviour) when the key is
// absent or unreadable.
func updateCheckEnabled() {
  let cfg = readUserConfig()
  let v = cfg.updateCheck
  if (v == nil) { return true }
  // Tolerate yaml that round-tripped as a string ("false") — for
  // hand-edited config files. cmdConfig set coerces to real bools.
  if (type(v) == "string") {
    let lower = v.lower()
    if (lower == "false" || lower == "0" || lower == "no") { return false }
    return true
  }
  return v
}

func writeUserConfig(cfg) {
  // Create ~/.praia/ on demand. ext_grains/ may not exist yet (the
  // user might `sand config author "..."` before ever installing a
  // global grain), so we make .praia/ directly rather than relying
  // on ensureDir(globalGrainsDir()).
  let praiaDir = path.join(home(), ".praia")
  ensureDir(praiaDir)
  let lines = ""
  let ks = keys(cfg)
  for (k in ks) {
    if (cfg[k] == nil) { continue }
    lines = lines + "%{yaml.stringify(k)}: %{yaml.stringify(cfg[k])}\n"
  }
  fs.write(userConfigFile(), lines)
}

// User-global bindir: ~/.praia/bin/. Mirrors userGlobalDir() — same
// directory tree, so wrappers for user-scope grains land next to the
// grains they wrap.
func userBinDir() {
  return path.join(home(), ".praia", "bin")
}

// System-global bindir: derived from sys.libdir.
// libdir is `<prefix>/lib/praia`, so the matching bindir is
// `<prefix>/bin` — two `path.dirname` calls peel off the suffix.
// Fallback /usr/local/bin keeps `make install` working when praia
// was built without -DPRAIA_LIBDIR.
func systemBinDir() {
  let libdir = sys.libdir
  if (!libdir) { return "/usr/local/bin" }
  return path.join(path.dirname(path.dirname(libdir)), "bin")
}

// Choose bindir based on whether we're running as root, matching the
// scope decision globalGrainsDir() makes for the grain payload.
func globalBinDir() {
  if (sys.isRoot()) {
    return systemBinDir()
  }
  return userBinDir()
}

func ensureDir(dir) {
  if (!fs.exists(dir)) {
    fs.mkdir(dir)
  }
}

export {
  SAND_VERSION, SAND_REPO, SAND_REPO_URL,
  MANIFEST_NAME, LOCK_NAME, DEFAULT_MAIN, EXT_GRAINS_DIR,
  CONFIG_NAME, CONFIG_KEYS, CONFIG_SCHEMA,
  home, globalGrainsDir, systemGlobalDir, userGlobalDir, globalLockFile,
  localGrainsDir, localLockFile, ensureDir,
  userBinDir, systemBinDir, globalBinDir,
  userConfigFile, readUserConfig, writeUserConfig, isValidConfigKey,
  configKeyType, updateCheckEnabled,
  isAllowedSandSource
}
