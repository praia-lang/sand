use "./config"
use "./manifest"
use "./bin"
use "./git"
use "./registry"
use "./integrity"
use "./printer"
use "./updateCheck"
use "progress"

func printUsage() {
  printer.header("sand v%{config.SAND_VERSION} - package manager for Praia")
  print("")
  print("  sand init                  Create a grain.yaml in the current directory")
  print("  sand init --plugin         Create a grain with a native C++ plugin")
  print("  sand install               Restore grains from sand-lock.yaml")
  print("  sand install <url>         Install a grain from a Git URL")
  print("  sand install --global <url>  Install a grain globally")
  print("  sand update                Re-fetch all grains pinned to 'latest'")
  print("  sand update <name>         Re-fetch a single grain from its source")
  print("  sand lock                  Sync sand-lock.yaml with grain.yaml (install missing deps)")
  print("  sand remove <name>         Remove a locally installed grain")
  print("  sand remove --global <name>  Remove a globally installed grain")
  print("                               (prompts to cascade-remove dependents; use -y to skip)")
  print("  sand list                  List locally installed grains")
  print("  sand list --global         List globally installed grains")
  print("  sand info <name>           Show info about an installed grain")
  print("  sand --version             Print sand version")
  print("  sand help                  Show this help")
  print("")
  print("  URL format: github.com/user/repo or github.com/user/repo@0.2.0")
  print("")
  print("  Grains are installed to ext_grains/ by default.")
  print("  Use --global to install to ~/.praia/ext_grains/ instead.")
  print("  Use --verbose for detailed output (shows git commands, etc.)")
  print("  Use --ignore-missing-deps to keep going when a transitive dep fails.")
  print("")
  print("  Grains with a `bin:` section in grain.yaml install CLI wrappers")
  print("  to ~/.praia/bin/ (user) or /usr/local/bin/ (root) on --global.")
}

// Parse flags from args, returns {global, verbose, ignoreMissing, rest}
func parseFlags(args) {
  let isGlobal = false
  let isVerbose = false
  let ignoreMissing = false
  let yes = false
  let rest = []
  for (arg in args) {
    if (arg == "--global" || arg == "-g") {
      isGlobal = true
    } elif (arg == "--verbose") {
      isVerbose = true
    } elif (arg == "--ignore-missing-deps") {
      ignoreMissing = true
    } elif (arg == "--yes" || arg == "-y") {
      yes = true
    } else {
      push(rest, arg)
    }
  }
  return { global: isGlobal, verbose: isVerbose, ignoreMissing: ignoreMissing,
           yes: yes, rest: rest }
}

func getTargetDir(isGlobal) {
  if (isGlobal) {
    return config.globalGrainsDir()
  }
  return config.localGrainsDir()
}

func getLockFile(isGlobal) {
  if (isGlobal) {
    return config.globalLockFile()
  }
  return config.localLockFile()
}

// Synthesize a virtual lockfile entry for sand when it was installed
// via `make install` (or release tarball) and no global lockfile entry
// exists yet. Avoids requiring a separate "register-self" bootstrap
// step from the Makefile: every operation that needs a sand entry —
// list, update, info — calls this on miss and gets a sensible one
// derived from sand's own grain.yaml.
//
// Checks the system-global location too (not just the root-scoped
// `globalGrainsDir()`) so a non-root user invoking `sand update sand`
// against a system-wide sand install still gets a valid synth entry.
// The downstream `installGrain` preflight then catches the actual
// "this needs sudo" case with a clean message — instead of bailing
// here with a misleading "Grain 'sand' is not installed".
//
// Returns nil only when sand isn't installed in any of the standard
// locations.
func synthSandEntry() {
  let candidates = [
    path.join(config.globalGrainsDir(), "sand"),
    path.join(config.systemGlobalDir(), "sand"),
    path.join(config.userGlobalDir(),   "sand"),
  ]
  for (sandDir in candidates) {
    let manifestPath = path.join(sandDir, config.MANIFEST_NAME)
    if (!fs.exists(manifestPath)) { continue }
    try {
      let m = manifest.read(sandDir)
      return {
        source: config.SAND_REPO,
        version: m.version,
        url: config.SAND_REPO_URL,
        installed: "bundled"
      }
    } catch (e) {
      // Try the next candidate — a malformed manifest at one
      // location shouldn't mask a working install at another.
    }
  }
  return nil
}

// Look up `name` in `lockFile`, falling back to a synthesized entry
// for sand when applicable. Use in any flow that needs to find an
// installed grain by name (list/update/info).
func registryGetOrSynth(lockFile, name, isGlobal) {
  let info = registry.get(lockFile, name)
  if (info) { return info }
  if (isGlobal && name == "sand") { return synthSandEntry() }
  return nil
}

// ── Commands ──

func cmdInit(args) {
  let flags = parseFlags(args)
  let isPlugin = false
  let rest = []
  for (arg in flags.rest) {
    if (arg == "--plugin" || arg == "-p") {
      isPlugin = true
    } else {
      push(rest, arg)
    }
  }

  let dir = sys.cwd()
  let manifestPath = path.join(dir, config.MANIFEST_NAME)

  if (fs.exists(manifestPath)) {
    printer.warn("grain.yaml already exists in this directory")
    return
  }

  let name = path.basename(dir)
  let m = manifest.create(name)
  manifest.write(dir, m)

  // Splice a commented `bin:` hint into the freshly written grain.yaml
  // so users discover that CLI entry points are a thing. The section
  // is live (`bin:` with no children) — leaving it parses as null, so
  // libraries don't need to do anything. Filling in entries makes
  // `sand install -g` plant wrappers on PATH. Comments themselves are
  // lost on round-trip (sand's yaml writer is a generator, not a
  // formatter), but the user got the hint on first read.
  let manifestPath = path.join(dir, config.MANIFEST_NAME)
  let hint = "# bin: declares CLI entry points planted on PATH when this\n" +
             "# grain is installed globally (`sand install -g`). Each key is\n" +
             "# the command name, each value a relative .praia file. Leave\n" +
             "# empty for libraries. Example:\n" +
             "#   bin:\n" +
             "#     %{name}: main.praia\n" +
             "bin:\n"
  let yamlText = fs.read(manifestPath)
  fs.write(manifestPath, yamlText.replace("dependencies:", hint + "dependencies:"))

  let mainPath = path.join(dir, config.DEFAULT_MAIN)
  if (!fs.exists(mainPath)) {
    if (isPlugin) {
      fs.write(mainPath, "let ext = \".dylib\"\nif (sys.platform != \"darwin\") { ext = \".so\" }\n\nlet _native = loadNative(path.dirname(sys.currentFile()) + \"/plugins/%{name}\" + ext)\n\n// Export your plugin functions here\n// let myFunc = _native.myFunc\n// export { myFunc }\n")
    } else {
      fs.write(mainPath, "print('Hello from %{name}!')\n")
    }
  }

  if (isPlugin) {
    // Create plugins/ directory with C++ template
    let pluginsDir = path.join(dir, "plugins")
    if (!fs.exists(pluginsDir)) {
      fs.mkdir(pluginsDir)
    }

    let cppPath = path.join(pluginsDir, name + ".cpp")
    if (!fs.exists(cppPath)) {
      fs.write(cppPath, "#include \"praia_plugin.h\"\n\nextern \"C\" void praia_register(PraiaMap* module) {\n    module->entries[\"hello\"] = Value(makeNative(\"%{name}.hello\", 0,\n        [](const std::vector<Value>& args) -> Value {\n            return Value(std::string(\"Hello from %{name}!\"));\n        }));\n}\n")
    }

    // Create Makefile
    let makefilePath = path.join(dir, "Makefile")
    if (!fs.exists(makefilePath)) {
      fs.write(makefilePath, "PRAIA_INCLUDE := $(shell praia --include-path)\nUNAME_S := $(shell uname -s)\n\nifeq ($(UNAME_S),Darwin)\n  EXT = .dylib\n  LDFLAGS = -undefined dynamic_lookup\nelse\n  EXT = .so\n  LDFLAGS =\nendif\n\nall:\n\tg++ -std=c++17 -shared -fPIC -I$(PRAIA_INCLUDE) $(LDFLAGS) -o plugins/%{name}$(EXT) plugins/%{name}.cpp\n\nclean:\n\trm -f plugins/%{name}.dylib plugins/%{name}.so\n\n.PHONY: all clean\n")
    }

    printer.success("Created plugin grain '%{name}' with:")
    printer.info("  grain.yaml")
    printer.info("  main.praia")
    printer.info("  plugins/%{name}.cpp")
    printer.info("  Makefile")
    printer.info("")
    printer.info("Build with: make")
  } else {
    printer.success("Created grain.yaml and %{config.DEFAULT_MAIN} for '%{name}'")
  }
}

// `visited` is a map of grain names → true, used to detect cycles in
// transitive dependency installs (e.g. A → B → A). Top-level callers omit it
// so each fresh install starts with an empty set.
//
// `preserveInstalledDate` (string or nil): when restoring from sand-lock.yaml,
// pass the original date so the lockfile isn't marked as modified by a fresh
// install. Nil means "use today's date" (the normal install path).
//
// `ignoreMissing` (bool): if true, transitive dep failures degrade to a
// warning. If false (default), they propagate so the caller can roll back
// the parent grain too.
//
// `pin` (40-char hex SHA or nil): if set, the lockfile's recorded commit;
// the installer checks out that exact SHA instead of `parsed.version`.
// Drives reproducible restore even when the version label is a moving
// target like a branch tip or "latest".
//
// `expectedIntegrity` ("sha256-<hex>" or nil): if set, recompute the
// installed dir's integrity hash after install and abort if it doesn't
// match. Used by lockfile restore to detect tampered caches or a
// repo-side history rewrite that left the commit SHA stable but changed
// the content under it (e.g. a force-pushed tag).
//
// `force` (bool): bypass the "already installed" early-out. Used by
// `sand update`, which by construction is replacing an existing
// install. Without it, a plain `sand install foo` is still rejected
// when foo is already installed — the user has to remove first, the
// long-standing safety guard.
//
// On failure this function ROLLS BACK its own state and re-throws. The
// outermost (CLI) caller is responsible for catching the throw and exiting
// with a non-zero code.
func installGrain(spec, isGlobal, verbose = false, addToDeps = true, visited = {}, preserveInstalledDate = nil, ignoreMissing = false, pin = nil, expectedIntegrity = nil, force = false) {
  let parsed = git.parseSpec(spec)
  let name = parsed.name
  ensure (manifest.isValidName(name)) else {
    throw "Invalid grain name derived from spec '%{spec}': '%{name}' (must match [a-zA-Z0-9][a-zA-Z0-9_-]*)"
  }

  // Self-update permission preflight. When the user runs `sand install
  // -g sand` (or `sand update sand`) and the running sand lives under
  // the system bindir, we'd need write access to that location to
  // replace it. Refuse early — before the network fetch — with a
  // clean message telling the user to retry with sudo. Without this
  // the install would clone, copy, and only fail at the rename step
  // with an opaque EACCES from the OS.
  if (name == "sand" && isGlobal && !sys.isRoot()) {
    let cur = sys.currentFile()
    if (cur && cur.startsWith(config.systemGlobalDir())) {
      throw "sand is installed system-wide at " + config.systemGlobalDir() +
            "; re-run with sudo to self-update"
    }
  }

  // Cycle short-circuit: if this grain is already being installed in the
  // current chain, stop. (Lockfile registration also catches this in normal
  // flow, but a per-chain visited set is the canonical signal.)
  if (visited.has(name)) {
    printer.info("  Skipping '%{name}' (already in install chain — cycle)")
    return
  }

  let targetDir = getTargetDir(isGlobal)
  let lockFile = getLockFile(isGlobal)

  // Snapshot the prior lockfile entry (if any) before we mutate
  // anything. On failure we restore this exact entry so a botched
  // update doesn't leave the user with neither a working grain nor
  // a record of what was there before.
  let priorLockEntry = registry.get(lockFile, name)

  // "Already installed" only counts when the lock entry AND the dir
  // are both present, AND the caller didn't pass force=true. The
  // dir-missing case lets installFromLockFile restore over a stale
  // lock entry; the force=true case lets `sand update` replace the
  // current install via stage-then-swap.
  let preExistingDir = path.join(targetDir, name)
  if (priorLockEntry && fs.exists(preExistingDir) && !force) {
    printer.warn("'%{name}' is already installed (source: %{priorLockEntry.source})")
    printer.info("Use 'sand remove %{name}' first to reinstall")
    return
  }

  let spin = progress.spinner({message: "Installing %{name} from %{parsed.url}..."})
  if (!verbose) { spin.tick() }

  // Clone to temp dir
  let tmpDir = fs.tempDir("sand")
  let cloneDir = path.join(tmpDir, name)

  // Track install-side state so we can roll back cleanly on any failure.
  // `destDir` is set once we know the final install path (which depends on
  // the manifest-declared name read inside the try block).
  // `binWrappers` holds absolute paths of any `bin:` entries we planted
  // in the bindir; the catch unlinks them so a half-finished install
  // doesn't leave a working CLI pointing at a deleted grain.
  // `binRestorable` holds the per-target byte+mode backup of any
  // sand-managed wrapper we OVERWROTE — needed so a post-swap failure
  // (e.g. transitive dep install) can restore the user's prior CLI
  // alongside the destDir restore from bakDir.
  let destDir = ""
  let destDirTouched = false
  let binWrappers = []
  let binRestorable = []

  try {
    if (verbose) { printer.info("Cloning %{parsed.url} -> %{cloneDir}") }
    else { spin.tick("Cloning %{parsed.url}...") }
    git.clone(parsed.url, cloneDir, verbose)

    // SHA pin (from a lockfile restore) always wins over the version
    // label. Without this, restoring a lock that recorded `version:
    // main` would re-fetch the latest `main` and silently install a
    // newer revision — the entire point of pinning the SHA was to
    // prevent that.
    if (pin) {
      if (verbose) { printer.info("Checking out pinned commit %{pin}...") }
      else { spin.tick("Checking out pinned commit %{pin.slice(0, 8)}...") }
      git.checkout(cloneDir, pin, verbose)
    } elif (parsed.version) {
      if (verbose) { printer.info("Checking out %{parsed.version}...") }
      else { spin.tick("Checking out %{parsed.version}...") }
      git.checkout(cloneDir, parsed.version, verbose)
    }
    // Capture the resolved commit *after* any checkout so the lockfile
    // entry always reflects what we actually installed, never what the
    // user typed.
    let resolvedCommit = git.revParse(cloneDir, "HEAD")

    // Determine main file and grain name from manifest
    if (!verbose) { spin.tick("Checking manifest...") }
    let mainFile = config.DEFAULT_MAIN
    let grainManifestPath = path.join(cloneDir, config.MANIFEST_NAME)
    let grainManifest = nil
    if (fs.exists(grainManifestPath)) {
      grainManifest = manifest.read(cloneDir)
      if (grainManifest.main) {
        mainFile = grainManifest.main
      }
      // Use the grain's declared name for the install directory
      if (grainManifest.name && grainManifest.name != name) {
        name = grainManifest.name
        // Re-check cycle and lockfile under the manifest-declared name
        if (visited.has(name)) {
          spin.done()
          printer.info("  Skipping '%{name}' (already in install chain — cycle)")
          try { fs.remove(tmpDir) } catch (e) {}
          return
        }
        // Re-snapshot the prior lock entry under the manifest-declared
        // name so rollback can restore it. Same "lock + dir = refuse,
        // lock alone = restore" rule as the up-front check.
        priorLockEntry = registry.get(lockFile, name)
        let renamedDir = path.join(targetDir, name)
        if (priorLockEntry && fs.exists(renamedDir) && !force) {
          spin.done()
          printer.warn("'%{name}' is already installed (source: %{priorLockEntry.source})")
          printer.info("Use 'sand remove %{name}' first to reinstall")
          try { fs.remove(tmpDir) } catch (e) {}
          return
        }
      }
    }

    // Reserved-name gate.
    //
    // The grain *name* "sand" controls the install directory under
    // `<libdir>/ext_grains/sand/` and — when isGlobal — the wrapper
    // at `<bindir>/sand`. A third-party repo whose manifest declares
    // `name: sand` would otherwise overwrite the user's actual sand:
    // running that bin wrapper, every subsequent `sand foo`
    // invocation runs the attacker's code.
    //
    // Allowed sources for the reserved name:
    //   • config.SAND_REPO_URL — the canonical praia-lang/sand. Matches
    //     specs like `github.com/praia-lang/sand`, `praia-lang/sand`,
    //     and the literal https URL, all normalized by parseSpec.
    //   • file:// URLs — local mirrors and the dev/test path. A
    //     user with file:// access already has local code execution,
    //     so this isn't a meaningful weakening of the guarantee. It
    //     keeps `sand update sand` testable without a github fetch.
    //
    // Everything else (any other https/http URL) gets rejected here,
    // *before* the staging directory is created. A user who needs to
    // install a fork has to either land their changes upstream or
    // install the fork under a different name. The predicate lives
    // in config.praia so tests can probe the policy without going
    // through a full clone.
    if (name == "sand" && !config.isAllowedSandSource(parsed.url)) {
      spin.done()
      throw "Refusing to install '%{spec}' as sand: the reserved 'sand' name may only be claimed by the canonical upstream at %{config.SAND_REPO_URL} or a local file:// mirror (got %{parsed.url})"
    }

    // Verify entry file exists
    let srcEntry = path.join(cloneDir, mainFile)
    ensure (fs.exists(srcEntry)) else {
      spin.done()
      throw "Entry file '%{mainFile}' not found in grain repository"
    }

    // Ensure target directory exists
    config.ensureDir(targetDir)

    // Stage-then-swap for every grain.
    //
    // Stage the new content into a sibling directory, run all the
    // checks that can fail (integrity, validation), and *only then*
    // atomically rename it into place. The previous install — and
    // any sand-managed bin wrappers that point at it — stays
    // working until the swap succeeds.
    //
    // Old broken pattern (removed): a non-sand grain went through
    // `fs.remove(destDir); fs.copy(cloneDir, destDir)`. If the copy
    // crashed midway, the user was left with neither the old
    // install nor a complete new one. Sand's self-update already
    // used the staging pattern; this generalizes it.
    destDir = path.join(targetDir, name)
    let pid = str(sys.getpid())
    let stageDir = destDir + ".new." + pid
    let bakDir = destDir + ".bak." + pid

    if (verbose) { printer.info("Staging to %{stageDir}") }
    else { spin.tick("Staging to %{targetDir}...") }

    // Clean up any leftovers from an interrupted prior run.
    if (fs.exists(stageDir)) { fs.remove(stageDir) }
    if (fs.exists(bakDir))   { fs.remove(bakDir) }

    fs.copy(cloneDir, stageDir)
    let stageDotGit = path.join(stageDir, ".git")
    if (fs.exists(stageDotGit)) { fs.remove(stageDotGit) }

    // Integrity check runs against the staged dir before the swap
    // so a mismatch (tampered cache, corrupt clone) doesn't touch
    // the still-installed previous version.
    if (!verbose) { spin.tick("Computing integrity...") }
    let resolvedIntegrity = integrity.compute(stageDir)
    if (expectedIntegrity && expectedIntegrity != resolvedIntegrity) {
      try { fs.remove(stageDir) } catch (e) {}
      throw "Lockfile integrity mismatch for '%{name}': expected %{expectedIntegrity}, got %{resolvedIntegrity}. The pinned commit %{resolvedCommit} resolved to different content than was recorded — investigate before continuing."
    }

    // Two-rename atomic swap. The window where destDir doesn't
    // exist is bracketed by both renames on the same filesystem and
    // is microsecond-scale — short enough that a concurrent reader
    // is unlikely to catch the gap, and any failure between the two
    // renames triggers the catch below which restores destDir from
    // bakDir.
    if (verbose) { printer.info("Atomic-swap to %{destDir}") }
    else { spin.tick("Atomic-swap to %{targetDir}...") }
    if (fs.exists(destDir)) { fs.move(destDir, bakDir) }
    destDirTouched = true
    try {
      fs.move(stageDir, destDir)
    } catch (err) {
      // The swap failed mid-flight. If bakDir survived, restore it
      // so the user still has a working install — and clear
      // destDirTouched so the outer catch doesn't then turn around
      // and delete the freshly-restored dir.
      if (fs.exists(bakDir) && !fs.exists(destDir)) {
        try {
          fs.move(bakDir, destDir)
          destDirTouched = false
        } catch (e) {}
      }
      if (fs.exists(stageDir)) { try { fs.remove(stageDir) } catch (e) {} }
      throw err
    }

    // Plant `bin:` wrappers on PATH for global installs. Local installs
    // are project-scoped and shouldn't pollute the user's PATH. Wrappers
    // get written AFTER the swap so they always point at a destDir
    // that actually holds the new content — never a half-installed
    // directory. bin.install also overwrites existing sand-managed
    // wrappers with per-target backup, so an update of a kept-name
    // entry restores the old wrapper bytes on rollback.
    if (isGlobal && grainManifest && grainManifest.bin) {
      let binDir = config.globalBinDir()
      config.ensureDir(binDir)
      if (!verbose) { spin.tick("Installing bin wrappers...") }
      // Sand is the one grain allowed to claim the reserved `sand`
      // bin name — third-party grains are blocked from spoofing it.
      // The trust check is "the manifest-declared name is literally
      // 'sand'", not the install spec, so a fork like
      // github.com/forker/sand can't sneak in unless its own
      // grain.yaml claims the name.
      let allowReserved = (name == "sand")
      let binResult = bin.install(destDir, grainManifest, binDir, allowReserved)
      binWrappers = binResult.written
      binRestorable = binResult.restorable
      bin.pathAdvisory(binDir)
    }

    // Keep bakDir alive past this point. We deliberately do NOT
    // remove it yet — the lockfile write and the transitive deps
    // loop below can still throw. If they do, the outer catch needs
    // bakDir to restore the prior install. The cleanup happens at
    // the end of this try block (after the deps loop) so the
    // success path drops the backup once everything's committed.

    // Register in lock file
    if (!verbose) { spin.tick("Updating lock file...") }
    let version = parsed.version
    if (!version) { version = "latest" }
    let installedDate = preserveInstalledDate
    if (!installedDate) {
      installedDate = sys.exec(["date", "+%Y-%m-%d"]).stdout.strip()
    }
    // Strip any `@<version>` suffix from the user-typed spec before
    // saving it as `source`. Without this, restore concatenates the
    // version pin on top of a source that already has it embedded
    // (e.g. `file://repo@v1@v1`), which parseSpec then mis-derives a
    // name from and rejects.
    let sourceForLock = spec
    if (parsed.version && spec.endsWith("@" + parsed.version)) {
      sourceForLock = spec.slice(0, len(spec) - len(parsed.version) - 1)
    }
    registry.add(lockFile, name, {
      source: sourceForLock,
      version: version,
      url: parsed.url,
      commit: resolvedCommit,
      integrity: resolvedIntegrity,
      installed: installedDate
    })

    let location = "ext_grains/"
    if (isGlobal) { location = "~/.praia/ext_grains/" }
    if (!verbose) { spin.done() }
    printer.success("Installed %{name}@%{version} -> %{location}%{name}/")
    // Surface every CLI wrapper we just planted so the user can see
    // which commands are now on PATH. Display paths under $HOME with
    // a `~` prefix to match the grain-location line above; absolute
    // paths (root installs to /usr/local/bin) print verbatim.
    if (len(binWrappers) > 0) {
      let homePrefix = config.home() + "/"
      for (w in binWrappers) {
        let display = w
        if (w.startsWith(homePrefix)) {
          display = "~/" + w.slice(len(homePrefix), len(w))
        }
        printer.success("Installed %{name}@%{version} -> %{display}")
      }
    }

    // Mark this grain as in-flight for cycle detection in recursive deps.
    visited[name] = true

    // Install transitive dependencies. By default, a failure here propagates
    // so the parent grain is also rolled back — a grain without its declared
    // deps is broken. `--ignore-missing-deps` (passed from the CLI) demotes
    // the failure to a warning for users who explicitly want partial installs.
    if (grainManifest && grainManifest.dependencies) {
      let depKeys = keys(grainManifest.dependencies)
      for (depName in depKeys) {
        let depSource = grainManifest.dependencies[depName]
        if (visited.has(depName)) {
          printer.info("  Skipping dependency '%{depName}' (cycle)")
          continue
        }
        if (!registry.get(lockFile, depName)) {
          printer.info("  Installing dependency: %{depName}")
          if (ignoreMissing) {
            try {
              installGrain(str(depSource), isGlobal, verbose, false, visited, nil, ignoreMissing)
            } catch (e) {
              printer.warn("  Failed to install '%{depName}': %{e} (continuing — --ignore-missing-deps)")
            }
          } else {
            installGrain(str(depSource), isGlobal, verbose, false, visited, nil, ignoreMissing)
          }
        }
      }
    }

    // Everything past the swap completed: wrappers planted, lockfile
    // updated, transitive deps installed. NOW we can drop the
    // pre-swap backup. Doing it any earlier (e.g. right after
    // wrappers) would mean a failure in the lockfile write or deps
    // loop has no rollback target — exactly the bug this comment
    // exists to prevent.
    if (fs.exists(bakDir)) { try { fs.remove(bakDir) } catch (e) {} }
  } catch (err) {
    if (!verbose) { spin.done() }
    // Bin wrappers we planted in this run go away first so a working
    // wrapper never outlives the grain dir it points at. bin.install
    // already restored wrappers if IT threw — but if it returned
    // successfully and a *later* step (lockfile write, transitive
    // dep install) threw, the new wrappers are still in place and
    // the original wrapper bytes are tracked in `binRestorable`.
    // We unlink the new ones, then put the old ones back, so the
    // restored destDir + restored wrappers describe the same prior
    // install.
    for (w in binWrappers) {
      try { fs.remove(w) } catch (e) {}
    }
    for (r in binRestorable) {
      try {
        fs.atomicWrite(r.target, r.content)
        fs.chmod(r.target, r.mode)
      } catch (e) {}
    }
    // Roll the dir back to the prior install if we swapped. If we
    // never got to the swap, destDirTouched is false and the old
    // install is right where the user left it.
    if (destDirTouched) {
      let pidS = str(sys.getpid())
      let stageRollback = destDir + ".new." + pidS
      let bakRollback   = destDir + ".bak." + pidS
      if (fs.exists(stageRollback)) {
        try { fs.remove(stageRollback) } catch (e) {}
      }
      if (fs.exists(bakRollback)) {
        // Update path: there was a prior install. Restore it.
        if (fs.exists(destDir)) {
          try { fs.remove(destDir) } catch (e) {}
        }
        try { fs.move(bakRollback, destDir) } catch (e) {}
      } else {
        // Fresh install path: no prior content to restore — just
        // unlink the half-installed dir so the user is back to a
        // pristine "never installed this grain" state.
        if (fs.exists(destDir)) {
          try { fs.remove(destDir) } catch (e) {}
        }
      }
    }
    // Lockfile rollback: if there was a prior entry, put it back so a
    // failed update doesn't strand the user without a record of what
    // used to be installed. Only remove the entry outright when there
    // was nothing here before this install attempt.
    if (priorLockEntry) {
      try { registry.add(lockFile, name, priorLockEntry) } catch (e) {}
    } else {
      try { registry.remove(lockFile, name) } catch (e) {}
    }
    try { fs.remove(tmpDir) } catch (e) {}
    // Re-throw so the caller (top-level cmd or parent installGrain) can
    // decide whether to abort the chain or roll back further.
    throw err
  }

  // Cleanup temp dir on success
  try { fs.remove(tmpDir) } catch (e) {}

  // Add to current project's grain.yaml if installing a new grain (not from lockfile)
  if (addToDeps && !isGlobal) {
    let cwd = sys.cwd()
    if (fs.exists(path.join(cwd, config.MANIFEST_NAME))) {
      try {
        manifest.addDep(cwd, name, spec)
        printer.info("Added %{name} to grain.yaml dependencies")
      } catch (e) {
        printer.warn("Could not update grain.yaml: " + str(e))
      }
    }
  }
}

func installFromLockFile(isGlobal, verbose = false, ignoreMissing = false) {
  let lockFile = getLockFile(isGlobal)
  let lock = registry.load(lockFile)
  let grainKeys = keys(lock.grains)

  if (len(grainKeys) == 0) {
    printer.info("No grains in lock file")
    return
  }

  let targetDir = getTargetDir(isGlobal)
  printer.header("Installing grains from %{config.LOCK_NAME}...")

  let installed = 0
  for (name in grainKeys) {
    let info = lock.grains[name]
    let grainDir = path.join(targetDir, name)

    // Capture original install date so we can preserve it across the
    // remove-and-reinstall path used here (lockfile restores shouldn't mark
    // the lock as modified).
    let preservedDate = info.installed
    if (fs.exists(grainDir)) {
      // Restore semantics: an existing grain dir is assumed to be at
      // the lockfile state. The user runs `sand update` to bump.
      // Forcing a refetch here would silently move "latest" pins
      // forward — exactly what the SHA pin in the lockfile is meant
      // to prevent.
      printer.info("  %{name}@%{info.version} already installed, skipping")
    } else {
      // Directory missing — installGrain treats "lock entry exists
      // but dir is gone" as the restore path and overwrites the
      // entry on success. We deliberately do NOT pre-remove the
      // lock entry: if the install fails, installGrain's catch
      // restores the prior entry so the user still has the
      // information they need to retry.
      let spec = str(info.source)
      // Old lockfiles (pre-fix) sometimes saved `source` with the
      // `@<version>` suffix already baked in. Guard the append so we
      // don't double-pin on restore — that produces specs like
      // `file://repo@v1@v1` which fail to parse.
      if (info.version && info.version != "latest" &&
          !spec.endsWith("@" + info.version)) {
        spec = spec + "@" + info.version
      }
      // SHA pin + integrity hash from the lockfile drive a reproducible
      // re-install: even if `version` is a moving tag, we re-check out
      // exactly the commit we recorded, and verify the resulting tree
      // matches the content hash we recorded. Older lockfiles missing
      // these fields fall back to a version-driven install (no pin)
      // — the user is told indirectly via the lack of a checksum
      // line when their next install regenerates the lockfile.
      installGrain(spec, isGlobal, verbose, false, {}, preservedDate, ignoreMissing, info.commit, info.integrity)
      installed = installed + 1
    }
  }

  if (installed == 0) {
    printer.success("All grains already up to date")
  } else {
    printer.success("Installed %{installed} grain(s)")
  }
}

func cmdInstall(args) {
  let flags = parseFlags(args)

  if (len(flags.rest) == 0) {
    try {
      installFromLockFile(flags.global, flags.verbose, flags.ignoreMissing)
    } catch (e) {
      printer.error("Install failed: %{e}")
      sys.exit(1)
    }
  } else {
    for (spec in flags.rest) {
      try {
        installGrain(spec, flags.global, flags.verbose, true, {}, nil, flags.ignoreMissing)
      } catch (e) {
        printer.error("Install failed: %{e}")
        sys.exit(1)
      }
    }
  }
}

// `sand update [name]` — re-fetch a grain from its source. Unlike
// `sand install` (which restores), this is an intentional bump: today's date
// is recorded in the lockfile.
func cmdUpdate(args) {
  let flags = parseFlags(args)
  // `sand update sand` (no -g) auto-promotes to global. Sand is a
  // reserved name and can never be installed locally, so demanding
  // the user remember `-g` for this specific operation is just
  // friction. Other names stay explicit — only the single-arg
  // `sand` case gets the shortcut.
  if (!flags.global && len(flags.rest) == 1 && flags.rest[0] == "sand") {
    flags.global = true
  }
  let lockFile = getLockFile(flags.global)
  let targetDir = getTargetDir(flags.global)

  let lock = registry.load(lockFile)
  let grainKeys = keys(lock.grains)

  // NOTE: don't short-circuit on an empty lockfile here. The
  // named-args path below uses registryGetOrSynth so that
  // `sand update sand` works on a fresh `make install` (the
  // bootstrap planted sand under ext_grains/ but never wrote a
  // lockfile entry). An early return based on len(grainKeys)==0
  // would skip past that synthesize logic.

  // Helper: re-fetch a single grain by name. Assumes the entry exists.
  // Returns true if it actually re-installed, false if the probe
  // showed there was nothing to do (so the caller can adjust the
  // batch summary).
  func updateOne(name, info) {
    printer.info("Updating %{name}...")
    let grainDir = path.join(targetDir, name)

    // Probe the remote for the current SHA at the locked ref. If
    // it matches `info.commit`, the install on disk is already at
    // the latest revision — skip the clone+swap. We only do this
    // when the lockfile recorded a commit (older lockfiles fall
    // through to the full update path; their next install will
    // populate `commit:` for future probes).
    if (info.commit && info.url) {
      let remoteSha = nil
      try {
        remoteSha = git.lsRemote(info.url, info.version)
      } catch (e) {
        // Transport failure — fall through to the normal update,
        // which will fail loudly at the clone step with the same
        // diagnostic. Don't double-report here.
      }
      if (remoteSha && remoteSha == info.commit && fs.exists(grainDir)) {
        printer.info("  already at %{info.commit.slice(0, 8)} — up to date")
        return false
      }
    }

    // Snapshot the OLD bin: list before installGrain runs. We don't
    // touch the wrappers yet — installGrain plants the new ones via
    // atomic overwrite, and we use this list afterward to unlink any
    // wrapper that the new version dropped (renamed-away or removed).
    // Reading the old manifest *before* the install lets that diff
    // happen even if the new manifest looks completely different.
    let oldBinNames = []
    if (flags.global && fs.exists(grainDir)) {
      try {
        let oldManifest = manifest.read(grainDir)
        if (oldManifest.bin) {
          oldBinNames = keys(oldManifest.bin)
        }
      } catch (e) {
        // Same defensive policy as cmdRemove — a malformed old
        // manifest shouldn't block an update. Worst case: an orphan
        // wrapper lingers; the user can `sand remove` to clean up.
      }
    }

    let spec = str(info.source)
    if (info.version && info.version != "latest") {
      spec = spec + "@" + info.version
    }
    try {
      // installGrain stages the new content alongside the existing
      // grainDir, atomically renames into place, and (on any failure
      // before the rename succeeds) restores the prior install via
      // its bakDir. We *never* pre-remove grainDir here — that was
      // the old bug. `force=true` opts past the "already installed"
      // refuse check, which is otherwise the right behavior for
      // plain `sand install`.
      installGrain(spec, flags.global, flags.verbose, false, {}, nil, flags.ignoreMissing, nil, nil, true)
    } catch (e) {
      // installGrain rolled back its own state — destDir + any
      // wrappers it had planted. The OLD wrappers (and old
      // grainDir) were never touched, so the user's CLI keeps
      // working at the prior version.
      printer.error("Update failed: %{e}")
      sys.exit(1)
    }

    // Post-success: clean up orphan wrappers. Anything in oldBinNames
    // that isn't in the *new* manifest's bin: section is now
    // unreferenced and should go away. Wrappers planted by
    // installGrain (for kept-or-new names) stay.
    if (flags.global && len(oldBinNames) > 0 && fs.exists(grainDir)) {
      let newBinNames = []
      try {
        let newManifest = manifest.read(grainDir)
        if (newManifest.bin) {
          newBinNames = keys(newManifest.bin)
        }
      } catch (e) {}
      let newBinSet = {}
      for (n in newBinNames) { newBinSet[n] = true }
      let oldBinDir = config.globalBinDir()
      for (oldBinName in oldBinNames) {
        if (newBinSet.has(oldBinName)) { continue }
        let oldPath = path.join(oldBinDir, oldBinName)
        if (fs.exists(oldPath) && bin.isSandManaged(oldPath)) {
          try { fs.remove(oldPath) } catch (e) {}
        }
      }
    }
    return true
  }

  if (len(flags.rest) == 0) {
    // Update every grain pinned to "latest". An empty lockfile here
    // is the only case where "no grains installed" applies — the
    // user passed no names, so registryGetOrSynth can't rescue us.
    if (len(grainKeys) == 0) {
      printer.info("No grains installed")
      return
    }
    let updated = 0
    let checked = 0
    for (name in grainKeys) {
      let info = lock.grains[name]
      if (info.version == "latest") {
        checked = checked + 1
        if (updateOne(name, info)) { updated = updated + 1 }
      }
    }
    if (checked == 0) {
      printer.info("No grains pinned to 'latest' to update")
    } elif (updated == 0) {
      printer.success("All grains already up to date")
    } else {
      printer.success("Updated %{updated} grain(s)")
    }
  } else {
    // Update each named grain
    for (name in flags.rest) {
      ensure (manifest.isValidName(name)) else {
        printer.error("Invalid grain name: '%{name}'")
        sys.exit(1)
      }
      // synth lookup so `sand update sand` works after a fresh
      // `make install` (lockfile won't have a sand entry yet).
      let info = registryGetOrSynth(lockFile, name, flags.global)
      if (!info) {
        printer.error("Grain '%{name}' is not installed")
        sys.exit(1)
      }
      // Special-case `sand update sand`: the synth entry pins
      // `version` to the *running* sand's version, which would make
      // updateOne reinstall the same version it's already at. The
      // user explicitly asked to update, so probe upstream live
      // (bypassing the 24h notifier cache) for the actual latest
      // tag and pin to that. If the probe fails (offline, no tags)
      // we fall through to the original synth version — same result
      // as before this hook existed.
      if (name == "sand" && flags.global) {
        let latest = updateCheck.fetchLatestTag()
        if (latest) {
          info.version = latest
        }
      }
      updateOne(name, info)
      // Refresh the notifier cache too: the user just ran an
      // explicit update, so the cache should reflect "we know
      // current upstream is X" rather than leaving last week's
      // value to drive a spurious "update available" notice on
      // the next sand invocation.
      if (name == "sand" && flags.global && info.version &&
          info.version != "latest") {
        updateCheck.recordKnownLatest(info.version)
      }
    }
  }
}

// `sand lock` — sync sand-lock.yaml with grain.yaml. Installs any dep that's
// declared in grain.yaml but missing from the lockfile or ext_grains/. Useful
// after manual edits to grain.yaml. Does NOT prune lockfile entries (those
// may be transitive dependencies the user can't see in grain.yaml).
func cmdLock(args) {
  let flags = parseFlags(args)

  if (flags.global) {
    printer.error("'sand lock' has no global mode (lockfile is per-project)")
    sys.exit(1)
  }

  let cwd = sys.cwd()
  let manifestPath = path.join(cwd, config.MANIFEST_NAME)
  ensure (fs.exists(manifestPath)) else {
    printer.error("No %{config.MANIFEST_NAME} found in the current directory")
    sys.exit(1)
  }

  let m = manifest.read(cwd)
  let lockFile = getLockFile(false)
  let targetDir = getTargetDir(false)

  if (!m.dependencies) {
    printer.info("No dependencies declared in %{config.MANIFEST_NAME}")
    return
  }
  let depKeys = keys(m.dependencies)
  if (len(depKeys) == 0) {
    printer.info("No dependencies declared in %{config.MANIFEST_NAME}")
    return
  }

  let installedCount = 0
  for (depName in depKeys) {
    let depSource = str(m.dependencies[depName])
    let lockEntry = registry.get(lockFile, depName)
    let grainDir = path.join(targetDir, depName)
    let needsInstall = !lockEntry || !fs.exists(grainDir)
    if (needsInstall) {
      // Clear stale state if either side is partial
      if (fs.exists(grainDir)) { fs.remove(grainDir) }
      if (lockEntry) { registry.remove(lockFile, depName) }
      try {
        installGrain(depSource, false, flags.verbose, false, {}, nil, flags.ignoreMissing)
      } catch (e) {
        printer.error("Lock failed: %{e}")
        sys.exit(1)
      }
      installedCount = installedCount + 1
    }
  }

  if (installedCount == 0) {
    printer.success("Lockfile is up to date")
  } else {
    printer.success("Locked %{installedCount} grain(s)")
  }
}

// Find every grain in the given scope that lists `name` in its
// `dependencies` map — directly or transitively. Returns the names
// in reverse-dep order (closest dependents first). Best-effort: a
// grain whose manifest fails to read is silently skipped (we can't
// tell whether it depends on `name`, but blocking removal on an
// unrelated corruption is worse than the leak).
func findTransitiveDependents(targetDir, lockFile, name) {
  let lock = registry.load(lockFile)
  let grainNames = keys(lock.grains)

  // Forward dep map: <grainName> → [its direct deps]. Built once
  // so the BFS below is O(grains * spreads-per-grain) rather than
  // re-reading manifests on each round.
  let forwardDeps = {}
  for (g in grainNames) {
    let gdir = path.join(targetDir, g)
    if (!fs.exists(path.join(gdir, config.MANIFEST_NAME))) {
      forwardDeps[g] = []
      continue
    }
    try {
      let m = manifest.read(gdir)
      if (m.dependencies) {
        forwardDeps[g] = keys(m.dependencies)
      } else {
        forwardDeps[g] = []
      }
    } catch (e) {
      forwardDeps[g] = []
    }
  }

  let dependents = []
  let seen = {}
  let frontier = [name]
  while (len(frontier) > 0) {
    let next = []
    for (target in frontier) {
      for (g in grainNames) {
        if (g == name || seen.has(g)) { continue }
        let gDeps = forwardDeps[g]
        for (d in gDeps) {
          if (d == target) {
            dependents.push(g)
            seen[g] = true
            next.push(g)
            break
          }
        }
      }
    }
    frontier = next
  }
  return dependents
}

// Per-grain removal — extracted from cmdRemove so cascade-on-remove
// can call it once per affected grain. Does NOT prompt or check
// dependents; the orchestrating cmdRemove already validated.
func removeOneGrain(name, flags) {
  let targetDir = getTargetDir(flags.global)
  let lockFile = getLockFile(flags.global)

  // Unlink any bin: wrappers BEFORE removing the grain dir, so a
  // failure midway leaves the grain dir intact (recoverable) rather
  // than leaving wrappers pointing at a deleted grain.
  let grainDir = path.join(targetDir, name)
  if (flags.global && fs.exists(grainDir)) {
    try {
      let m = manifest.read(grainDir)
      if (m.bin) {
        bin.remove(m, config.globalBinDir())
      }
    } catch (e) {
      printer.warn("Could not read manifest to clean up bin wrappers: %{e}")
    }
  }

  if (fs.exists(grainDir)) {
    fs.remove(grainDir)
  }
  let grainFile = path.join(targetDir, "%{name}.praia")
  if (fs.exists(grainFile)) {
    fs.remove(grainFile)
  }

  registry.remove(lockFile, name)
  printer.success("Removed %{name}")

  if (!flags.global) {
    let cwd = sys.cwd()
    if (fs.exists(path.join(cwd, config.MANIFEST_NAME))) {
      manifest.removeDep(cwd, name)
      printer.info("Removed %{name} from grain.yaml dependencies")
    }
  }
}

func cmdRemove(args) {
  let flags = parseFlags(args)

  ensure (len(flags.rest) > 0) else {
    printer.error("Usage: sand remove [--global] [--yes] <name>")
    sys.exit(1)
  }

  let name = flags.rest[0]
  ensure (manifest.isValidName(name)) else {
    printer.error("Invalid grain name: '%{name}'")
    sys.exit(1)
  }
  let targetDir = getTargetDir(flags.global)
  let lockFile = getLockFile(flags.global)

  let existing = registry.get(lockFile, name)
  if (!existing) {
    printer.error("Grain '%{name}' is not installed")
    sys.exit(1)
  }

  // Cascade-on-remove: if any installed grain (in the same scope)
  // depends on `name`, removing `name` alone would leave them with
  // a broken `use` import. Warn, prompt for confirmation, then
  // remove every dependent first.
  //
  // The --yes flag (or piped non-interactive stdin returning nil)
  // controls the prompt: --yes skips it, non-interactive sessions
  // fail safe by treating EOF as "no".
  let dependents = findTransitiveDependents(targetDir, lockFile, name)
  if (len(dependents) > 0) {
    printer.warn("Removing %{name} will also remove these dependents: %{dependents.join(", ")}")
    if (!flags.yes) {
      sys.stdout("continue? (y/N) ")
      let ans = sys.input(nil)
      if (!ans) {
        printer.info("Aborted (no input)")
        return
      }
      let lower = ans.lower().strip()
      if (lower != "y" && lower != "yes") {
        printer.info("Aborted")
        return
      }
    }
    // Remove dependents in dependency order (deepest first). Each
    // removal cleans up its own bin wrappers + lockfile entry +
    // grain.yaml dep (if local). If one fails partway through, we
    // stop — already-removed dependents stay removed but the user
    // can re-run after fixing the cause.
    for (dep in dependents) {
      removeOneGrain(dep, flags)
    }
  }

  removeOneGrain(name, flags)
}

func cmdList(args) {
  let flags = parseFlags(args)
  let lockFile = getLockFile(flags.global)
  let grains = registry.list(lockFile)

  // Lazy bootstrap: when listing the global scope and sand was
  // installed via `make install` but no lockfile entry exists yet,
  // synthesize one from sand's grain.yaml so it shows up like any
  // other installed grain.
  if (flags.global && !grains.sand) {
    let synth = synthSandEntry()
    if (synth) { grains["sand"] = synth }
  }

  let grainKeys = keys(grains)

  let scope = "local"
  if (flags.global) { scope = "global" }

  if (len(grainKeys) == 0) {
    printer.info("No %{scope} grains installed")
    return
  }

  printer.header("Installed grains (%{scope}):")
  for (name in grainKeys) {
    let info = grains[name]
    let version = info.version
    if (!version) { version = "latest" }
    print("  %{name}@%{version} <- %{info.source}")
  }
  print("")
  printer.info("%{len(grainKeys)} grain(s) installed")
}

func cmdInfo(args) {
  let flags = parseFlags(args)

  ensure (len(flags.rest) > 0) else {
    printer.error("Usage: sand info <name>")
    sys.exit(1)
  }

  let name = flags.rest[0]

  // Check local first, then global. Falls through to a synthesized
  // sand entry so `sand info sand` works after a fresh `make install`.
  let info = registry.get(config.localLockFile(), name)
  let scope = "local"
  if (!info) {
    info = registryGetOrSynth(config.globalLockFile(), name, true)
    scope = "global"
  }

  if (!info) {
    printer.error("Grain '%{name}' is not installed")
    sys.exit(1)
  }

  printer.header(name)
  print("  version:   %{info.version}")
  print("  source:    %{info.source}")
  print("  url:       %{info.url}")
  print("  scope:     %{scope}")
  if (info.installed) {
    print("  installed: %{info.installed}")
  }
}

// ── Dispatch ──

func run(args) {
  if (len(args) == 0) {
    printUsage()
    return
  }

  let cmd = args[0]

  let rest = []
  for (i in 1..len(args)) {
    push(rest, args[i])
  }

  if (cmd == "init") { cmdInit(rest) }
  elif (cmd == "install" || cmd == "i") { cmdInstall(rest) }
  elif (cmd == "update" || cmd == "up") { cmdUpdate(rest) }
  elif (cmd == "lock") { cmdLock(rest) }
  elif (cmd == "remove" || cmd == "rm") { cmdRemove(rest) }
  elif (cmd == "list" || cmd == "ls") { cmdList(rest) }
  elif (cmd == "info") { cmdInfo(rest) }
  elif (cmd == "--version" || cmd == "-v") { print("sand v%{config.SAND_VERSION}") }
  elif (cmd == "help" || cmd == "--help" || cmd == "-h") { printUsage() }
  else {
    printer.error("Unknown command: %{cmd}")
    print("")
    printUsage()
    sys.exit(1)
  }

  // Self-update notifier. Runs after the command completes so it
  // tacks onto the bottom of output rather than interrupting it.
  // Skipped for fast read-only commands (--version, help) where the
  // user wants the bare info, and for `update sand` itself (the user
  // is already updating sand — telling them an update is available
  // would be noise). Wrapped in try/catch: a checker failure must
  // never break the actual command.
  let skipCheck = (cmd == "--version" || cmd == "-v"
                   || cmd == "help" || cmd == "--help" || cmd == "-h"
                   || ((cmd == "update" || cmd == "up")
                       && len(rest) > 0 && rest.contains("sand")))
  if (!skipCheck) {
    try { updateCheck.notifyIfAvailable() } catch (e) {}
  }
}

export { run }
