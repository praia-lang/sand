use "./config"
use "./manifest"
use "./printer"

// `bin:` wrapper management. A grain with `bin: { foo: bin/foo.praia }`
// gets a `foo` script planted in the bindir at install time and removed
// on `sand remove`. Wrappers are small shell scripts with absolute
// paths baked in — same shape as the bootstrap wrapper the Makefile
// writes for sand itself, so the two stay byte-identical.
//
// Reserved names: third-party grains can't claim `praia` or `sand` —
// only sand's own bootstrap is allowed to install a `sand` wrapper.

let RESERVED_NAMES = ["praia", "sand"]
let SENTINEL = "# sand-managed wrapper for "

func isReserved(name) {
  for (r in RESERVED_NAMES) {
    if (r == name) { return true }
  }
  return false
}

// Absolute path to the praia interpreter the wrapper should exec.
// Preference order:
//   1. `sys.executable` — canonical path of the currently-running
//      binary. Always correct: production sand runs from the
//      installed praia and points wrappers at it; dev/test sand
//      points wrappers at the dev binary it was run with. Means
//      tests don't depend on a stray /usr/local/bin/praia.
//   2. `<prefix>/bin/praia` derived from `sys.libdir` — fallback for
//      hypothetical builds where executable resolution failed.
//   3. `/usr/local/bin/praia` — last-resort universal default.
// The path is baked into the wrapper at install time so the wrapper
// doesn't depend on `praia` being on PATH at run time.
func praiaPath() {
  if (sys.executable) { return sys.executable }
  let libdir = sys.libdir
  if (libdir) {
    return path.join(path.dirname(path.dirname(libdir)), "bin", "praia")
  }
  return "/usr/local/bin/praia"
}

// POSIX single-quote escape for shell. Wraps the input in `'…'` and
// replaces any embedded `'` with the canonical `'\''` sequence. Safe
// for any byte sequence — single-quoted strings in sh have no escape
// processing, so the only character that needs special handling is
// the quote itself. Prevents wrapper-injection when a grain ships a
// `bin:` script path containing shell metacharacters like `"`, `$`,
// backticks, or `;`.
func shellQuote(s) {
  let out = "'"
  for (ch in s) {
    if (ch == "'") {
      out = out + "'\\''"
    } else {
      out = out + ch
    }
  }
  out = out + "'"
  return out
}

// Exact text of a sand-managed wrapper. The format MUST match the
// Makefile/release.yml/install.sh bootstrap output byte-for-byte
// (a test asserts this) so `sand install -g sand@<ver>` regenerates
// exactly what the install path wrote. Paths are POSIX single-quoted
// rather than double-quoted so a grain can't smuggle shell metachars
// (`"`, `$`, backticks) into the wrapper.
func wrapperContent(name, praiaAbsPath, scriptAbsPath) {
  let lines = "#!/bin/sh\n"
  lines = lines + SENTINEL + name + "\n"
  lines = lines + "exec " + shellQuote(praiaAbsPath) + " " + shellQuote(scriptAbsPath) + " \"$@\"\n"
  return lines
}

// Treat a file at <binDir>/<name> as ours iff its second line carries
// the sentinel. Refusing to overwrite foreign executables keeps sand
// from clobbering a user's hand-installed CLI.
func isSandManaged(filepath) {
  if (!fs.exists(filepath)) { return false }
  let content = ""
  try { content = fs.read(filepath) } catch (e) { return false }
  let nl = content.indexOf("\n")
  if (nl < 0) { return false }
  let rest = content.slice(nl + 1, len(content))
  return rest.startsWith(SENTINEL)
}

// Install all wrappers declared in `manifestMap.bin` to `binDir`.
// Validates each name/path again at install time (defense-in-depth —
// the manifest was validated on read, but we don't trust state we
// haven't checked locally). Returns the list of written paths so the
// caller can roll back on a later failure.
//
// `allowReserved` lets sand's own bootstrap claim `sand`; third-party
// grains never pass this.
func install(grainDir, manifestMap, binDir, allowReserved = false) {
  let written = []
  // Per-target backup. Entry shape: {target, existed, content, mode}.
  // `existed` distinguishes "we created this file from scratch" (rollback
  // should remove it) from "we overwrote a sand-managed wrapper from a
  // previous install" (rollback should restore its original bytes + mode
  // so the user keeps the working CLI they had before).
  let backups = []
  if (!manifestMap.bin) { return written }
  let binKeys = keys(manifestMap.bin)
  try {
    for (name in binKeys) {
      if (isReserved(name) && !allowReserved) {
        throw "Refusing to install reserved bin name '%{name}' (reserved for sand)"
      }
      let relPath = manifestMap.bin[name]
      ensure (manifest.isValidBinName(name)) else {
        throw "Invalid bin name '%{name}'"
      }
      ensure (manifest.isValidBinPath(relPath)) else {
        throw "Invalid bin path for '%{name}': '%{relPath}'"
      }
      let scriptAbs = path.join(grainDir, relPath)
      ensure (fs.exists(scriptAbs)) else {
        throw "Bin entry '%{name}' points at missing file %{scriptAbs}"
      }
      let target = path.join(binDir, name)
      let existed = fs.exists(target)
      if (existed && !isSandManaged(target)) {
        throw "Refusing to overwrite %{target} (not a sand-managed wrapper)"
      }
      // Snapshot the existing wrapper (if any) before we overwrite it,
      // so a later failure in this batch can restore the user's prior
      // CLI rather than vaporize it.
      let prevContent = nil
      let prevMode = nil
      if (existed) {
        try { prevContent = fs.read(target) } catch (e) {}
        try { prevMode = fs.stat(target).mode } catch (e) {}
      }
      backups.push({target: target, existed: existed,
                    content: prevContent, mode: prevMode})
      fs.atomicWrite(target, wrapperContent(name, praiaPath(), scriptAbs))
      fs.chmod(target, 0o755)
      written.push(target)
    }
  } catch (err) {
    // All-or-nothing rollback. Files that didn't exist before this
    // call get unlinked; files that did exist (sand-managed wrappers
    // from a prior install of the same grain) get their bytes and
    // mode restored. Each step is best-effort — losing rollback for
    // one entry shouldn't stop us from trying the rest.
    for (b in backups) {
      if (b.existed) {
        try {
          if (b.content != nil) { fs.atomicWrite(b.target, b.content) }
          if (b.mode != nil)    { fs.chmod(b.target, b.mode) }
        } catch (e) {}
      } else {
        if (fs.exists(b.target)) {
          try { fs.remove(b.target) } catch (e) {}
        }
      }
    }
    throw err
  }
  return written
}

// Best-effort unlink of every wrapper declared by `manifestMap.bin`.
// Skips files we don't own (sentinel mismatch) so we never delete a
// foreign script with a colliding name. Used by `sand remove` and by
// the update path before reinstall.
func remove(manifestMap, binDir) {
  if (!manifestMap.bin) { return }
  let binKeys = keys(manifestMap.bin)
  for (name in binKeys) {
    let target = path.join(binDir, name)
    if (fs.exists(target) && isSandManaged(target)) {
      try { fs.remove(target) } catch (e) {}
    }
  }
}

// Print a PATH advisory if the bindir we just wrote to isn't on the
// user's PATH. Fires every install — the previous once-only sentinel
// suppressed the warning after the first install, which meant users
// who fixed their PATH and then later broke it (new shell config,
// different machine, etc.) got installed CLIs that silently didn't
// work. Cheap to repeat; loud enough to act on.
func pathAdvisory(binDir) {
  // System bindir (/usr/local/bin, /usr/bin) is universally on PATH —
  // skip the advisory.
  if (binDir.startsWith("/usr/")) { return }
  let pathVar = sys.env("PATH")
  if (!pathVar) { return }
  let entries = pathVar.split(":")
  for (e in entries) {
    if (e == binDir) { return }
  }
  print("")
  printer.warn("%{binDir} is not on your PATH, add it to run installed CLIs:")
  printer.info("export PATH=\"%{binDir}:$PATH\"")
}

export {
  RESERVED_NAMES, SENTINEL,
  isReserved, praiaPath, wrapperContent, isSandManaged,
  install, remove, pathAdvisory
}
